# systemd unit for running without Docker.
# sudo cp deploy/naiosh.service /etc/systemd/system/ && sudo systemctl enable --now naiosh
[Unit]
Description=NAIOSH Intelligence
After=network.target

[Service]
Type=simple
User=naiosh
WorkingDirectory=/opt/naiosh
EnvironmentFile=/opt/naiosh/.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=TRUST_PROXY=1
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/naiosh/data /opt/naiosh/public

[Install]
WantedBy=multi-user.target
