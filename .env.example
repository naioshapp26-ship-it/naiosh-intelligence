# ===== NAIOSH Intelligence — environment =====
# Your domain (DNS A record must point to this server's IP before starting)
DOMAIN=app.example.com
# Full public address, used for security checks and secure cookies
APP_ORIGIN=https://app.example.com

# First system admin — created automatically on first start only.
# Password: at least 10 characters with letters and digits. Change it after first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-2026
ADMIN_NAME=د. عدنان

# Optional
SESSION_HOURS=12
MAX_VIDEO_MB=500
MAX_FILE_MB=50

# Sign-up verification codes: demo (codes shown on screen) or live (sent by email + SMS)
VERIFY_MODE=demo
# RESEND_API_KEY=
# MAIL_FROM=NAIOSH <no-reply@your-domain.com>
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=+1XXXXXXXXXX
# Wallet top-ups: demo (adds points without payment)
PAYMENT_MODE=demo
